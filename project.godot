; Engine configuration file.
; BODYGUARD INC. — 2-4 Player Co-op Physics Chaos Game (Godot 4.3+)

config_version=5

[application]

config/name="BODYGUARD INC."
config/description="2–4 player co-op physics chaos & stealth-action game in Godot 4.3+: escort a suicidal low-IQ VIP across 5 themed 52m x 136m luxury venues, battle armored guards & assassins with upgradable Plasma & Cryo-Freeze weapons from Big Tony's Armory, or drag the VIP corpse Weekend at Bernie's style with proximity voice jaw lip-sync."
run/main_scene="res://src/scenes/gala_level.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[display]

window/size/viewport_width=1360
window/size/viewport_height=820
window/stretch/mode="canvas_items"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/return_value_discarded=1

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_interpolation=true
3d/physics_engine="DEFAULT"
