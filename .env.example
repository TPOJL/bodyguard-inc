# BODYGUARD INC. — Environment Variables Template
# Copy to `.env` locally (`.env` is gitignored and blocked by secret_guard.py).
# NEVER put real secrets in `.env.example` or any tracked file.

# Optional override for local Godot 4.3+ executable path
GODOT_BIN=/Applications/Godot.app/Contents/MacOS/Godot

# Production Steam App ID (Phase 3+ SteamP2P transport; keep real IDs local)
STEAM_APP_ID=YOUR_STEAM_APP_ID_HERE

# Optional telemetry / crash reporting endpoint (leave empty for local dev)
TELEMETRY_API_KEY=YOUR_API_KEY_HERE
