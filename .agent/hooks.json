{
  "gdscript-post-edit": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/post-edit.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "milestone-stop-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "./hooks/stop-gate.sh",
        "timeout": 90
      }
    ]
  }
}
